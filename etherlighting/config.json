    "ssh_username": "",
    "ssh_password": "",
    "ssh_host_key": "",
    "refresh_seconds": 30,
    "allow_led_control": false,
    "allow_experimental_models": false
  },
  "schema": {
    "switch_host": "str",
    "ssh_username": "str",
    "ssh_password": "password",
    "ssh_host_key": "str",
    "refresh_seconds": "int(15,300)",
    "allow_led_control": "bool",
    "allow_experimental_models": "bool"
  }
}
