{
  "name": "Etherlighting",
  "version": "0.4.0",
  "slug": "etherlighting",
  "description": "Discover switch MAC addresses and plan per-device port colors. Experimental LED control is off by default.",
  "arch": ["amd64", "aarch64"],
  "startup": "application",
  "boot": "manual",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
